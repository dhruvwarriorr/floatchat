# Local scientific source files can be large or license-sensitive. Only the
# versioned, reviewable artifacts explicitly allowed below belong in Git.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/baselines/production/*
!data/baselines/production/.gitkeep
data/baselines/validation/*
!data/baselines/validation/.gitkeep
demo/cached/*
!demo/cached/.gitkeep
demo/cached_responses/*
!demo/cached_responses/.gitkeep
demo/screenshots/*
!demo/screenshots/.gitkeep
evaluation/results/*
!evaluation/results/.gitkeep
