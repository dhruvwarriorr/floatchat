{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floatchat.local/schemas/data-manifest.json",
  "title": "FloatChat-Lite data manifest",
  "type": "object",
  "required": ["status", "dataset_version", "source", "created_at", "build_command", "artifacts"],
  "properties": {
    "status": { "enum": ["draft", "ready"] },
    "dataset_version": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["name", "url", "accessed_at", "provenance_notes"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "accessed_at": { "type": "string", "format": "date" },
        "provenance_notes": { "type": "string" }
      },
      "additionalProperties": false
    },
    "created_at": { "type": "string", "format": "date-time" },
    "build_command": { "type": "string", "minLength": 1 },
    "qc_policy": { "type": "string" },
    "coverage": { "type": "object" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["profiles", "production_baseline", "validation_baseline"] },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
