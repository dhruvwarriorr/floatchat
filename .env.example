# Server-only settings. Copy to .env locally; never put secrets in frontend/.
FLOATCHAT_ENV=development
FLOATCHAT_DATA_DIR=./data
FLOATCHAT_STATIC_DIR=./frontend/dist
# The only optional parser credential. Select the provider below; never use a VITE_ prefix.
FLOATCHAT_LLM_API_KEY=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
FLOATCHAT_LLM_TIMEOUT_SECONDS=8
# Optional AI proofreading runs before the structured planner. Keep its model
# lightweight and its timeout short; manual parsing remains the fallback.
FLOATCHAT_LLM_SANITIZER_MODEL=gemini-2.5-flash-lite
FLOATCHAT_LLM_SANITIZER_TIMEOUT_SECONDS=2.5
FLOATCHAT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional alternate-provider compatibility settings:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_STYLE=responses
# For Groq/Ollama-compatible servers: LLM_API_STYLE=chat_completions
# For Anthropic: LLM_PROVIDER=anthropic and LLM_MODEL=claude-3-5-haiku-latest
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_STYLE=generate_content
